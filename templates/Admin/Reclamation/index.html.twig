{% extends 'Admin/admin_layout.html.twig' %}

{% block content %}
<div class="page-header">
    <h1>Gestion des Réclamations</h1>
    <div class="page-actions">
        <a href="{{ path('admin_reclamations_dashboard') }}" class="btn btn-dashboard">
            <i class="fas fa-chart-pie"></i> Tableau de bord
        </a>
    </div>
</div>

<!-- Statistics Dashboard -->
<div class="stats-dashboard">
    <div class="stats-card total">
        <span class="stats-label">Total des réclamations</span>
        <span class="stats-value">{{ statistics.total }}</span>
    </div>
    
    <div class="stats-card">
        <span class="stats-label">Par statut</span>
        <div class="stats-list">
            {% for status, count in statistics.byStatus %}
                <div class="stats-item">
                    <span class="status-label">{{ status }}</span>
                    <span class="status-count">{{ count }}</span>
                </div>
            {% endfor %}
        </div>
    </div>
    
    <div class="stats-card">
        <span class="stats-label">Par catégorie</span>
        <div class="stats-list">
            {% for category, count in statistics.byCategory %}
                <div class="stats-item">
                    <span class="category-label">{{ category }}</span>
                    <span class="category-count">{{ count }}</span>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<!-- Search and Filter Form -->
<div class="search-container">
    <form action="{{ path('admin_reclamations') }}" method="get" class="search-form">
        <div class="search-row">
            <div class="search-group">
                <label for="search">Rechercher:</label>
                <input type="text" name="search" id="search" placeholder="Nom, email ou message..." value="{{ searchTerm }}">
            </div>
            
            <div class="search-group">
                <label for="status">Statut:</label>
                <select name="status" id="status">
                    <option value="">Tous les statuts</option>
                    {% for status in statuses %}
                        <option value="{{ status }}" {% if status == selectedStatus %}selected{% endif %}>{{ status }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <div class="search-group">
                <label for="category">Catégorie:</label>
                <select name="category" id="category">
                    <option value="">Toutes les catégories</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}" {% if category.id == selectedCategory %}selected{% endif %}>{{ category.nom }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <button type="submit" class="btn btn-search">
                <i class="fas fa-search"></i> Rechercher
            </button>
            
            <a href="{{ path('admin_reclamations') }}" class="btn btn-reset">
                <i class="fas fa-redo"></i> Réinitialiser
            </a>
        </div>
    </form>
</div>

<div class="table-container">
    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>
                <a href="{{ path('admin_reclamations', {
                    'sort': 'category',
                    'direction': sortField == 'category' and sortDirection == 'ASC' ? 'DESC' : 'ASC',
                    'search': searchTerm,
                    'status': selectedStatus,
                    'category': selectedCategory
                }) }}" class="sortable-header">
                    Catégorie
                    {% if sortField == 'category' %}
                        <i class="fas fa-sort-{{ sortDirection == 'ASC' ? 'up' : 'down' }}"></i>
                    {% else %}
                        <i class="fas fa-sort"></i>
                    {% endif %}
                </a>
            </th>
            <th>
                <a href="{{ path('admin_reclamations', {
                    'sort': 'nom',
                    'direction': sortField == 'nom' and sortDirection == 'ASC' ? 'DESC' : 'ASC',
                    'search': searchTerm,
                    'status': selectedStatus,
                    'category': selectedCategory
                }) }}" class="sortable-header">
                    Nom
                    {% if sortField == 'nom' %}
                        <i class="fas fa-sort-{{ sortDirection == 'ASC' ? 'up' : 'down' }}"></i>
                    {% else %}
                        <i class="fas fa-sort"></i>
                    {% endif %}
                </a>
            </th>
            <th>
                <a href="{{ path('admin_reclamations', {
                    'sort': 'email',
                    'direction': sortField == 'email' and sortDirection == 'ASC' ? 'DESC' : 'ASC',
                    'search': searchTerm,
                    'status': selectedStatus,
                    'category': selectedCategory
                }) }}" class="sortable-header">
                    Email
                    {% if sortField == 'email' %}
                        <i class="fas fa-sort-{{ sortDirection == 'ASC' ? 'up' : 'down' }}"></i>
                    {% else %}
                        <i class="fas fa-sort"></i>
                    {% endif %}
                </a>
            </th>
            <th>Message</th>
            <th>
                <a href="{{ path('admin_reclamations', {
                    'sort': 'statut',
                    'direction': sortField == 'statut' and sortDirection == 'ASC' ? 'DESC' : 'ASC',
                    'search': searchTerm,
                    'status': selectedStatus,
                    'category': selectedCategory
                }) }}" class="sortable-header">
                    Statut
                    {% if sortField == 'statut' %}
                        <i class="fas fa-sort-{{ sortDirection == 'ASC' ? 'up' : 'down' }}"></i>
                    {% else %}
                        <i class="fas fa-sort"></i>
                    {% endif %}
                </a>
            </th>
            <th>
                <a href="{{ path('admin_reclamations', {
                    'sort': 'createdAt',
                    'direction': sortField == 'createdAt' and sortDirection == 'ASC' ? 'DESC' : 'ASC',
                    'search': searchTerm,
                    'status': selectedStatus,
                    'category': selectedCategory
                }) }}" class="sortable-header">
                    Date de création
                    {% if sortField == 'createdAt' %}
                        <i class="fas fa-sort-{{ sortDirection == 'ASC' ? 'up' : 'down' }}"></i>
                    {% else %}
                        <i class="fas fa-sort"></i>
                    {% endif %}
                </a>
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for reclamation in reclamations %}
        <tr>
            <td>{{ reclamation.id }}</td>
            <td>{{ reclamation.category.nom }}</td>
            <td>{{ reclamation.nom }}</td>
            <td>{{ reclamation.email }}</td>
            <td>{{ reclamation.message }}</td>
            <td>
                <span class="status-badge status-{{ reclamation.statut|lower }}">{{ reclamation.statut }}</span>
            </td>
            <td>{{ reclamation.createdAt|date('Y-m-d H:i') }}</td>
            <td class="actions-cell">
                <a href="{{ path('admin_reclamation_edit', {'id': reclamation.id}) }}" class="btn btn-edit">
                    <i class="fas fa-edit"></i> Éditer
                </a>
                <a href="{{ path('admin_reclamation_delete', {'id': reclamation.id}) }}" class="btn btn-delete" 
                   onclick="return confirm('Supprimer cette réclamation ?');">
                    <i class="fas fa-trash"></i> Supprimer
                </a>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="8" class="no-results">Aucune réclamation trouvée.</td></tr>
    {% endfor %}
    </tbody>
    </table>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Page Header */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    
    .page-actions {
        display: flex;
        gap: 10px;
    }
    
    .btn-dashboard {
        background: #3498db;
        color: white;
        padding: 8px 15px;
        border-radius: 4px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 14px;
        transition: background 0.3s;
    }
    
    .btn-dashboard:hover {
        background: #2980b9;
    }
    
    /* Statistics Dashboard */
    .stats-dashboard {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 20px;
    }
    
    .stats-card {
        background: white;
        border-radius: 8px;
        padding: 15px;
        box-shadow: 0 3px 6px rgba(0, 0, 0, 0.1);
        flex: 1;
        min-width: 200px;
    }
    
    .stats-card.total {
        background: #3498db;
        color: white;
        text-align: center;
    }
    
    .stats-label {
        display: block;
        font-weight: bold;
        margin-bottom: 10px;
        font-size: 16px;
    }
    
    .stats-value {
        font-size: 32px;
        font-weight: bold;
    }
    
    .stats-list {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }
    
    .stats-item {
        display: flex;
        justify-content: space-between;
    }
    
    /* Search Form */
    .search-container {
        background: white;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        box-shadow: 0 3px 6px rgba(0, 0, 0, 0.1);
    }
    
    .search-form {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    
    .search-row {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        align-items: flex-end;
    }
    
    .search-group {
        flex: 1;
        min-width: 200px;
    }
    
    .search-group label {
        display: block;
        margin-bottom: 5px;
        font-weight: bold;
    }
    
    .search-group input, 
    .search-group select {
        width: 100%;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 4px;
    }
    
    .btn-search, .btn-reset {
        padding: 8px 15px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    
    .btn-search {
        background: #2ecc71;
        color: white;
    }
    
    .btn-reset {
        background: #e74c3c;
        color: white;
        text-decoration: none;
    }
    
    /* Sortable Headers */
    .sortable-header {
        display: flex;
        align-items: center;
        gap: 5px;
        color: white;
        text-decoration: none;
    }
    
    /* Status Badges */
    .status-badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
    }
    
    .status-nouveau {
        background-color: #3498db;
        color: white;
    }
    
    .status-en.traitement {
        background-color: #f39c12;
        color: white;
    }
    
    .status-résolu {
        background-color: #2ecc71;
        color: white;
    }
    
    .status-fermé {
        background-color: #7f8c8d;
        color: white;
    }
    
    /* Action buttons */
    .actions-cell {
        display: flex;
        gap: 5px;
    }
    
    .btn-edit, .btn-delete {
        padding: 5px 10px;
        text-decoration: none;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
    }
    
    .btn-edit {
        background-color: #3498db;
        color: white;
    }
    
    .btn-delete {
        background-color: #e74c3c;
        color: white;
    }
    
    .no-results {
        text-align: center;
        padding: 20px;
        color: #7f8c8d;
        font-style: italic;
    }
</style>
{% endblock %}
