{% extends 'Admin/admin_layout.html.twig' %}

{% block content %}
<div class="page-header">
    <h1>Tableau de bord des Réclamations</h1>
    <div class="page-actions">
        <a href="{{ path('admin_reclamations') }}" class="btn btn-back">
            <i class="fas fa-list"></i> Liste des réclamations
        </a>
    </div>
</div>

<div class="dashboard-container">
    <!-- Summary Cards -->
    <div class="stats-summary">
        <div class="summary-card">
            <div class="card-icon">
                <i class="fas fa-clipboard-list"></i>
            </div>
            <div class="card-content">
                <h3>Réclamations Totales</h3>
                <p class="count">{{ statistics.total }}</p>
            </div>
        </div>
        
        {% set statusCounts = statistics.byStatus %}
        {% set newCount = statusCounts['Nouveau'] ?? 0 %}
        {% set inProgressCount = statusCounts['En traitement'] ?? 0 %}
        {% set resolvedCount = statusCounts['Résolu'] ?? 0 %}
        
        <div class="summary-card card-new">
            <div class="card-icon">
                <i class="fas fa-file-alt"></i>
            </div>
            <div class="card-content">
                <h3>Nouvelles</h3>
                <p class="count">{{ newCount }}</p>
            </div>
        </div>
        
        <div class="summary-card card-progress">
            <div class="card-icon">
                <i class="fas fa-spinner"></i>
            </div>
            <div class="card-content">
                <h3>En traitement</h3>
                <p class="count">{{ inProgressCount }}</p>
            </div>
        </div>
        
        <div class="summary-card card-resolved">
            <div class="card-icon">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="card-content">
                <h3>Résolues</h3>
                <p class="count">{{ resolvedCount }}</p>
            </div>
        </div>
    </div>
    
    <!-- Charts Section -->
    <div class="charts-container">
        <div class="chart-card">
            <h3>Réclamations par statut</h3>
            <div class="chart-status">
                {% for status, count in statistics.byStatus %}
                {% set percentage = (count / statistics.total * 100) | round %}
                <div class="chart-bar-container">
                    <div class="chart-label">{{ status }}</div>
                    <div class="chart-bar">
                        <div class="chart-bar-fill status-{{ status|lower|replace({' ': '-'}) }}" 
                             style="width: {{ percentage }}%">
                            {{ count }} ({{ percentage }}%)
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        
        <div class="chart-card">
            <h3>Réclamations par catégorie</h3>
            <div class="chart-categories">
                {% for category, count in statistics.byCategory %}
                {% set percentage = (count / statistics.total * 100) | round %}
                <div class="chart-bar-container">
                    <div class="chart-label">{{ category }}</div>
                    <div class="chart-bar">
                        <div class="chart-bar-fill" style="width: {{ percentage }}%">
                            {{ count }} ({{ percentage }}%)
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    
    <!-- Recent Réclamations -->
    <div class="recent-reclamations">
        <h3>Réclamations récentes</h3>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Catégorie</th>
                        <th>Nom</th>
                        <th>Statut</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for reclamation in statistics.recent %}
                    <tr>
                        <td>{{ reclamation.id }}</td>
                        <td>{{ reclamation.category.nom }}</td>
                        <td>{{ reclamation.nom }}</td>
                        <td>
                            <span class="status-badge status-{{ reclamation.statut|lower|replace({' ': '-'}) }}">
                                {{ reclamation.statut }}
                            </span>
                        </td>
                        <td>{{ reclamation.createdAt|date('Y-m-d H:i') }}</td>
                        <td>
                            <a href="{{ path('admin_reclamation_edit', {'id': reclamation.id}) }}" class="btn btn-edit">
                                <i class="fas fa-edit"></i>
                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Page Header */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }
    
    .page-actions {
        display: flex;
        gap: 10px;
    }
    
    .btn-back {
        background: #3498db;
        color: white;
        padding: 8px 15px;
        border-radius: 4px;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 14px;
        transition: background 0.3s;
    }
    
    .btn-back:hover {
        background: #2980b9;
    }

    .dashboard-container {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    
    /* Summary Cards */
    .stats-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }
    
    .summary-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        display: flex;
        align-items: center;
        flex: 1;
        min-width: 200px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s;
    }
    
    .summary-card:hover {
        transform: translateY(-5px);
    }
    
    .card-new {
        border-left: 5px solid #3498db;
    }
    
    .card-progress {
        border-left: 5px solid #f39c12;
    }
    
    .card-resolved {
        border-left: 5px solid #2ecc71;
    }
    
    .card-icon {
        font-size: 2.5rem;
        color: #2c3e50;
        margin-right: 20px;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        border-radius: 50%;
    }
    
    .card-content h3 {
        margin: 0;
        font-size: 14px;
        color: #7f8c8d;
    }
    
    .card-content .count {
        font-size: 28px;
        font-weight: bold;
        margin: 5px 0 0 0;
    }
    
    /* Charts */
    .charts-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }
    
    .chart-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        flex: 1;
        min-width: 300px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .chart-card h3 {
        margin-top: 0;
        margin-bottom: 20px;
        color: #2c3e50;
        font-size: 18px;
        border-bottom: 1px solid #ecf0f1;
        padding-bottom: 10px;
    }
    
    .chart-bar-container {
        margin-bottom: 15px;
    }
    
    .chart-label {
        margin-bottom: 5px;
        font-weight: bold;
        color: #34495e;
    }
    
    .chart-bar {
        background: #f1f1f1;
        height: 25px;
        border-radius: 4px;
        overflow: hidden;
    }
    
    .chart-bar-fill {
        background: #3498db;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 12px;
        font-weight: bold;
        padding: 0 10px;
        transition: width 0.5s;
    }
    
    /* Status-specific colors */
    .chart-bar-fill.status-nouveau {
        background-color: #3498db;
    }
    
    .chart-bar-fill.status-en-traitement {
        background-color: #f39c12;
    }
    
    .chart-bar-fill.status-résolu {
        background-color: #2ecc71;
    }
    
    .chart-bar-fill.status-fermé {
        background-color: #7f8c8d;
    }
    
    /* Recent Réclamations */
    .recent-reclamations {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .recent-reclamations h3 {
        margin-top: 0;
        margin-bottom: 20px;
        color: #2c3e50;
        font-size: 18px;
        border-bottom: 1px solid #ecf0f1;
        padding-bottom: 10px;
    }
    
    /* Status badges */
    .status-badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
        text-transform: uppercase;
    }
    
    .status-nouveau {
        background-color: #3498db;
        color: white;
    }
    
    .status-en-traitement {
        background-color: #f39c12;
        color: white;
    }
    
    .status-résolu {
        background-color: #2ecc71;
        color: white;
    }
    
    .status-fermé {
        background-color: #7f8c8d;
        color: white;
    }
    
    /* Buttons */
    .btn-edit {
        background-color: #3498db;
        color: white;
        padding: 5px 10px;
        border-radius: 4px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
</style>
{% endblock %}
