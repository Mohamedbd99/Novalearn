{% extends 'Admin/admin_layout.html.twig' %}

{% block content %}
<h1>Éditer Réclamation</h1>
<div class="table-container">
{{ form_start(form) }}
    {{ form_row(form.category) }}
    {{ form_row(form.nom) }}
    {{ form_row(form.email) }}
    {{ form_row(form.message) }}
    {{ form_row(form.statut) }}    {{ form_row(form.createdAt) }}
    <button class="btn btn-ajout">Enregistrer</button>
{{ form_end(form) }}
<a href="{{ path('admin_reclamations') }}" class="btn btn-delete">Retour</a>
</div>
{% endblock %}
