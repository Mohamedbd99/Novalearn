{% extends 'Admin/admin_layout.html.twig' %}

{% block content %}
<h1>Gestion des Catégories</h1>
<a href="{{ path('admin_category_new') }}" class="btn btn-ajout">Ajouter une catégorie</a>
<div class="table-container">
    <table>
    <thead>
        <tr>            <th>ID</th>
            <th>Nom</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for category in categories %}
        <tr>            <td>{{ category.id }}</td>
            <td>{{ category.nom }}</td>
            <td>{{ category.description }}</td>
            <td>
                <a href="{{ path('admin_category_edit', {'id': category.id}) }}" class="btn btn-edit">Éditer</a>
                <a href="{{ path('admin_category_delete', {'id': category.id}) }}" class="btn btn-delete" onclick="return confirm('Supprimer cette catégorie ?');">Supprimer</a>
            </td>
        </tr>
    {% else %}
        <tr><td colspan="3">Aucune catégorie trouvée.</td></tr>
    {% endfor %}    </tbody>
    </table>
</div>
{% endblock %}
