{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <title>{% block title %}Novalearn{% endblock %}</title>
    {# Symfony will dump any CSS/JS from your controllers or assets here #}
    {{ encore_entry_link_tags('app') }}
    {% block css %}{% endblock %}
  </head>
  <body>
    {% block body %}{% endblock %}

    {{ encore_entry_script_tags('app') }}
    {% block javascripts %}{% endblock %}
  </body>
</html>
