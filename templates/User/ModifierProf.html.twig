{% block body %}
    <div class="edit-page-wrapper">
        <h1 class="page-title">Éditer l'utilisateur</h1>

        <div class="form-container">
            {{ form_start(form) }}

            <div class="form-group">{{ form_row(form.role) }}</div>
            <div class="form-group">{{ form_row(form.nom) }}</div>
            <div class="form-group">{{ form_row(form.prenom) }}</div>
            <div class="form-group">{{ form_row(form.age) }}</div>
            <div class="form-group">{{ form_row(form.num_tel) }}</div>
            <div class="form-group">{{ form_row(form.difficulte) }}</div>
            <div class="form-group">{{ form_row(form.niv_difficulte) }}</div>
            <div class="form-group">{{ form_row(form.email) }}</div>
            <div class="form-group">{{ form_row(form.password) }}</div>
            <div class="form-group">{{ form_row(form.genre) }}</div>

            <div class="form-actions">
                <button class="btn-primary" type="submit">Sauvegarder</button>
                <a href="{{ path('app_profile') }}" class="btn-secondary">Retour</a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
<style>
    body, html {
        margin: 0;
        padding: 0;
        height: 100%;
        background-color: #7a5cc9; /* Mauve vif */
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .edit-page-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .page-title {
        color: #fff;
        font-size: 2.2rem;
        margin-bottom: 30px;
        text-align: center;
    }

    .form-container {
        width: 100%;
        max-width: 700px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        padding: 40px;
        color: #fff;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        font-size: 1rem;
        color: #ffcc00;
        font-weight: 600;
        display: block;
        margin-bottom: 8px;
    }

    .form-control input,
    .form-control select,
    .form-control textarea {
        width: 100%;
        padding: 12px;
        font-size: 1rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        background-color: rgba(255, 255, 255, 0.9);
        color: #000;
        transition: border-color 0.3s ease;
    }

    .form-control input:focus,
    .form-control select:focus {
        border-color: #ffcc00;
        outline: none;
    }

    .form-actions {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 30px;
    }

    .btn-primary,
    .btn-secondary {
        flex: 1 1 45%;
        padding: 12px;
        font-size: 1rem;
        border-radius: 8px;
        text-decoration: none;
        text-align: center;
        font-weight: bold;
        transition: 0.3s ease;
        cursor: pointer;
        border: none;
    }

    .btn-primary {
        background-color: #ffcc00;
        color: #000;
    }

    .btn-primary:hover {
        background-color: #e6b800;
    }

    .btn-secondary {
        background-color: #542e7a;
        color: #fff;
    }

    .btn-secondary:hover {
        background-color: #3e215b;
    }

    @media (max-width: 600px) {
        .form-actions {
            flex-direction: column;
        }

        .btn-primary, .btn-secondary {
            width: 100%;
        }
    }
</style>
{% endblock %}