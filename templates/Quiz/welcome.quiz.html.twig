    <script>
      // Initialize userId from Twig variable.
      const userId = {{ userId|json_encode|raw }};

      // Array of quiz objects with subject mapping.
      const quizzes = [
        {
          name: "Mathematics Quiz",
          subject: "math", // Subject used in the URL route.
          image: "Quiz/math.png",
          duration: "30 minutes"
        },
        {
          name: "Science Quiz",
          subject: "science",
          image: "Quiz/science.jpg", // Corrected spelling.
          duration: "25 minutes"
        },
        {
          name: "Geography Quiz",
          subject: "geo",
          image: "Quiz/geo.jpg",
          duration: "20 minutes"
        },
        {
          name: "History Quiz",
          subject: "history",
          image: "Quiz/history.jpg",
          duration: "35 minutes"
        }
      ];

      // Create HTML for each quiz card and wrap it in a clickable link.
      const quizHTML = quizzes.map(quiz => `
        <a href="/quiz/${quiz.subject}/${userId}" class="quiz-card-link">
          <div class="quiz-card">
            <img src="${quiz.image}" alt="${quiz.name}">
            <div class="card-content">
              <h3 class="quiz-title">${quiz.name}</h3>
              <p class="quiz-duration">Duration: ${quiz.duration}</p>
            </div>
          </div>
        </a>
      `).join('');

      // Insert the generated HTML into the container.
      document.getElementById('quizContainer').innerHTML = quizHTML;
    </script>

