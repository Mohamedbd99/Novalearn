      <style>
:root {
  --card-bg: #fff;
  --card-border-radius: 10px;
  --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.1);
  --card-shadow-hover: 0 6px 16px rgba(0, 0, 0, 0.15);
  --card-padding: 1rem;
  --title-color: #333;
  --duration-color: #777;
  --transition-speed: 0.3s;
  --container-gap: 20px;
}

/* Container for the quiz cards */
.quiz-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: var(--container-gap);
  padding: var(--container-gap);
  max-width: 1200px;
  margin: 0 auto;
}

/* Individual quiz card styling */
.quiz-card {
  background: var(--card-bg);
  border-radius: var(--card-border-radius);
  box-shadow: var(--card-shadow);
  overflow: hidden;
  transition: transform var(--transition-speed) ease, box-shadow var(--transition-speed) ease;
  display: flex;
  flex-direction: column;
}

/* Hover effect to add subtle lift and extra shadow */
.quiz-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--card-shadow-hover);
}

/* Ensure images fill the width; height adjusts automatically */
.quiz-card img {
  width: 100%;
  height: auto;
  max-height:130px;
  object-fit: cover;
}

/* Content area inside the card */
.card-content {
  padding: var(--card-padding);
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* Quiz title styling */
.quiz-title {
  font-size: 1.5rem;
  margin: 0 0 0.5rem;
  color: var(--title-color);
  font-weight: 600;
}

/* Quiz duration styling */
.quiz-duration {
  font-size: 1rem;
  color: var(--duration-color);
}

/* Responsive adjustments for smaller devices */
@media (max-width: 768px) {
  .quiz-container {
    grid-template-columns: 1fr;
    padding: 10px;
    gap: 15px;
  }
  .quiz-title {
    font-size: 1.25rem;
  }
  .quiz-duration {
    font-size: 0.9rem;
  }
}
  </style>

