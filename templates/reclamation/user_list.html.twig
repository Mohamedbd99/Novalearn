<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mes réclamations - NovaLearn</title>
    <link rel="shortcut icon" type="image/x-icon" href="/assets/images/fav.png">
    <!-- fontawesome -->
    <link rel="stylesheet" href="/assets/css/plugins/fontawesome-6.css">
    <!-- Bootstrap -->
    <link rel="stylesheet" href="/assets/css/vendor/bootstrap.min.css">
    <!-- custom style css -->
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
    <!-- Start Contact form area -->
    <div class="rts-contact-form-area rts-section-gap">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="title-area-rts text-center">
                        <h2 class="title">Mes réclamations</h2>
                        <p>Liste des réclamations soumises pour {{ email }}</p>
                    </div>
                </div>
            </div>
            <div class="row justify-content-center mt--50">
                <div class="col-12">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Catégorie</th>
                                    <th>Nom</th>
                                    <th>Message</th>
                                    <th>Statut</th>
                                    <th>Date de soumission</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reclamation in reclamations %}
                                    <tr>                                        <td>{{ reclamation.id }}</td>
                                        <td>{{ reclamation.category.nom }}</td>
                                        <td>{{ reclamation.nom|filter_profanity }}</td>
                                        <td>{{ (reclamation.message|filter_profanity)|length > 100 ? (reclamation.message|filter_profanity)|slice(0, 100) ~ '...' : reclamation.message|filter_profanity }}</td>
                                        <td>
                                            {% if reclamation.statut == 'nouveau' %}
                                                <span class="badge bg-info">Nouveau</span>
                                            {% elseif reclamation.statut == 'en_cours' %}
                                                <span class="badge bg-warning">En cours</span>
                                            {% elseif reclamation.statut == 'resolu' %}
                                                <span class="badge bg-success">Résolu</span>
                                            {% else %}
                                                <span class="badge bg-secondary">{{ reclamation.statut }}</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ reclamation.createdAt|date('d/m/Y H:i') }}</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6" class="text-center">Aucune réclamation trouvée.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="row mt-5">
                <div class="col-12 text-center">
                    <a href="{{ path('app_reclamation_front') }}" class="rts-btn btn-primary">Soumettre une nouvelle réclamation</a>
                    <a href="/" class="rts-btn btn-secondary">Retour à l'accueil</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap & jQuery JS -->
    <script src="/assets/js/vendor/jquery.min.js"></script>
    <script src="/assets/js/vendor/bootstrap.min.js"></script>
</body>
</html>
