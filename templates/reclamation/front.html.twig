    <!-- Profanity check script -->
    <script>
        $(document).ready(function() {
            // Simple list of common profanity words to check client-side
            // This is just a basic check - server-side validation is more thorough
            const basicProfanityList = [
                'fuck', 'shit', 'ass', 'bitch', 'damn', 
                'dick', 'cunt', 'bastard', 'piss'
                // Note: this is just a minimal example list
            ];
            
            // Helper function to check text against profanity list
            function containsProfanity(text) {
                if (!text) return false;
                
                text = text.toLowerCase();
                for (const word of basicProfanityList) {
                    if (text.includes(word)) {
                        return true;
                    }
                }
                return false;
            }
            
            // Function to show warning if profanity is detected
            function checkInputForProfanity(input) {
                const value = $(input).val();
                const fieldName = $(input).attr('name').replace('reclamation_front[', '').replace(']', '');
                const fieldLabel = fieldName.charAt(0).toUpperCase() + fieldName.slice(1);
                
                // Remove any existing warning
                $(input).next('.profanity-warning').remove();
                
                // Check for profanity
                if (containsProfanity(value)) {
                    $(input).addClass('is-invalid');
                    $('<div class="profanity-warning text-danger mt-1">Attention: Ce texte pourrait contenir des termes inappropriés.</div>')
                        .insertAfter(input);
                } else {
                    $(input).removeClass('is-invalid');
                }
            }
            
            // Check message and name fields as user types
            $('#reclamation_front_message').on('blur', function() {
                checkInputForProfanity(this);
            });
            
            $('#reclamation_front_nom').on('blur', function() {
                checkInputForProfanity(this);
            });
            
            // Final check on form submission
            $('form.contact-form-contact').on('submit', function(e) {
                let hasProfanity = false;
                
                // Check all text inputs and textareas
                $('input[type="text"], textarea', this).each(function() {
                    if (containsProfanity($(this).val())) {
                        checkInputForProfanity(this);
                        hasProfanity = true;
                    }
                });
                
                // If profanity is found, show warning but still allow submission
                // (server-side validation will handle it)
                if (hasProfanity) {
                    if (!confirm('Des termes inappropriés ont été détectés. Ils seront automatiquement filtrés. Voulez-vous continuer?')) {
                        e.preventDefault();
                    }
                }
            });
        });    </script>
    
