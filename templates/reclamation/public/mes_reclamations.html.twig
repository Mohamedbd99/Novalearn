{% extends 'base.html.twig' %}

{% block title %}Mes Réclamations{% endblock %}

{% block body %}
    <div class="container-rounded">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="mb-0">Mes Réclamations</h1>
                    <a href="{{ path('app_reclamation_new') }}" class="btn btn-novalearn">
                        <i class="fas fa-plus me-2"></i>Ajouter une réclamation
                    </a>
                </div>

                {% if not email %}
                    <div class="card mb-4">
                        <div class="card-body">
                            <h2 class="h4 mb-3">Accéder à mes réclamations</h2>
                            <form method="post" action="{{ path('app_reclamation_mes_reclamations_email') }}">
                                <div class="mb-3">
                                    <label for="email" class="form-label">Votre email</label>
                                    <input type="email" class="form-control" id="email" name="email" required>
                                    <div class="form-text">Entrez l'email utilisé lors de la soumission de vos réclamations.</div>
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search me-2"></i>Voir mes réclamations
                                </button>
                            </form>
                        </div>
                    </div>
                {% endif %}

                {% if reclamations is not empty %}
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Message</th>
                                    <th>Statut</th>
                                    <th>Date de création</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reclamation in reclamations %}
                                    <tr>
                                        <td>{{ reclamation.nom }}</td>
                                        <td>{{ reclamation.message|slice(0, 50) }}{% if reclamation.message|length > 50 %}...{% endif %}</td>
                                        <td>
                                            <span class="badge bg-{{ reclamation.statut == 'En attente' ? 'warning' : (reclamation.statut == 'Traitée' ? 'success' : 'info') }}">
                                                {{ reclamation.statut }}
                                            </span>
                                        </td>
                                        <td>{{ reclamation.createdAt|date('d/m/Y H:i') }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% elseif email %}
                    <div class="alert alert-info">
                        Aucune réclamation trouvée pour cet email.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
