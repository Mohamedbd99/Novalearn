{# templates/post/index.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Fil d’actualité | Novalearn</title>

  <!-- Bootstrap & FontAwesome -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"/>

  <style>
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Arial',sans-serif; background:#f4f7fa; color:#333; }

    /* pill-nav */
    .top-nav {
      position:absolute; top:1rem; left:50%; transform:translateX(-50%);
      background:#fff; padding:.5rem 2rem; border-radius:50px;
      box-shadow:0 4px 10px rgba(0,0,0,0.1);
      display:flex; gap:1.5rem; align-items:center; z-index:10;
    }
    .top-nav .logo { font-size:1.5rem; font-weight:bold; color:#4CACFE; }
    .top-nav a { color:#333; text-decoration:none; font-weight:500; }
    .top-nav a:hover { text-decoration:underline; }

    /* hero */
    .hero {
      background:#7E4AE2; color:#fff; text-align:center;
      padding:6rem 1rem 12rem; position:relative;
    }
    .hero h1 { font-size:2.5rem; margin-bottom:.5rem; }
    .hero h1 span { color:#FFD247; }
    .hero p { max-width:600px; margin:0 auto; font-size:1.1rem; }
    .hero::after {
      content:''; position:absolute; bottom:-80px; left:0;
      width:100%; height:100px; background:#f4f7fa;
      border-radius:50% 50% 0 0;
    }

    /* feed container */
    .feed-card {
      max-width:800px;
      margin:-4rem auto 4rem;
      padding:0 1rem;
    }

    /* use Bootstrap cards */
    .post-card { margin-bottom:2rem; }
    .post-card .card {
      border-radius: 15px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .post-card .card-header {
      display:flex; justify-content:space-between; align-items:center;
      background:#fff; border-bottom:1px solid #eee;
      font-weight:600; color:#333;
    }
    .post-card .post-date { font-size:.85rem; color:#999; }
    .post-card .card-body {
      padding:1.5rem;
    }
    .post-title { font-size:1.75rem; font-family:serif; font-weight:700; margin-bottom:1rem; color:#2c3e50; }
    .post-text { font-size:1rem; line-height:1.6; color:#333; margin-bottom:1rem; }
    .post-image { max-width:100%; border-radius:8px; margin-bottom:1rem; }

    .back-btn {
      display:inline-block; margin-top:2rem;
      background:#0066cc; color:#fff; padding:.75rem 1.5rem;
      border-radius:5px; text-decoration:none;
    }
    .back-btn:hover { background:#004b8d; }
  </style>
</head>
<body>
  <nav class="top-nav">
    <div class="logo">Novalearn</div>
<a href="{{ path('app_HomeMedecin') }}">Home</a>
    <a href="/post/all">Tous les Posts</a>
    <a href="/post/add">Publier un Post</a>
  </nav>

  <section class="hero">
    <h1>Bienvenue sur <span>Novalearn !</span></h1>
    <p>Un espace où chaque jour est une occasion d’apprendre et de grandir.</p>
  </section>

  <div class="feed-card">
    {% for pwc in postsWithComments %}
      <div class="post-card">
        <div class="card">
          <div class="card-header">
            <span>
              {{ pwc.post.user and pwc.post.user.nom
                 ? pwc.post.user.nom
                 : 'Poste anonyme' }}
            </span>
            <small class="post-date">
              Publié le {{ pwc.post.createdAt|date('d M Y H:i') }}
            </small>
            <div class="dropdown">
              <button class="btn btn-sm btn-light btn-dropdown" data-bs-toggle="dropdown">
                <i class="fa-solid fa-ellipsis-vertical"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="{{ path('post_edit',{id:pwc.post.id}) }}">Modifier</a></li>
                <li>
                  <form method="POST" action="{{ path('post_delete',{id:pwc.post.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_post_'~pwc.post.id) }}">
                    <button class="dropdown-item" onclick="return confirm('Supprimer ce post ?')">Supprimer</button>
                  </form>
                </li>
              </ul>
            </div>
          </div>

          <div class="card-body">
            <div class="post-title">{{ pwc.post.title }}</div>
            {% if pwc.post.image %}
              <img src="{{ asset('images/'~pwc.post.image) }}" class="post-image">
            {% endif %}
            <div class="post-text">{{ pwc.post.content }}</div>

            {# …comments form & list… #}
          </div>
        </div>
      </div>
    {% else %}
      <p class="text-center">Aucun post trouvé.</p>
    {% endfor %}

    <div class="text-center">
    
      <a href="{{ path('app_HomeMedecin') }}" class="back-btn">Retour</a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
