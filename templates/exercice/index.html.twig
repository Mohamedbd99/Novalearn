    <!-- exercices area start -->
<section class="rts-event-area inner rts-section-gap">
    <div class="container">
        <div class="section-inner">
            <div class="row g-5">
                {% for exercice in exercices %}
                    <div class="col-lg-6">
                        <div class="event-wrapper inner">
                            <div class="wrapper-inner bg-one">
                                <div class="date">
                                    <span>{{ exercice.createdAt|date('d M Y') }}</span>
                                    <img src="assets/images/events/01.png" width="132" alt="" class="shape">
                                </div>
                                <div class="content">
                                    <!-- Lien dynamique vers la page de détails de l'exercice -->
                                    <a href="{{ path('app_exercice_show', {'id': exercice.id}) }}">
                                        <h4 class="title">{{ exercice.titre }}</h4>
                                    </a>
                                    <ul class="meta-wrapper">
                                        <li><i class="fa-regular fa-clock"></i> {{ exercice.createdAt|date('H:i') }}</li>
                                    </ul>
                                </div>
                                <div class="shape-icon"><img src="assets/images/events/event-blink.svg" alt=""></div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

