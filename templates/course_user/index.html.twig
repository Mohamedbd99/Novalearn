        <div class="course-wrapper-style-2 inner">
            <div class="wrapper-inner bg-seven">
                <div class="image">
                    <a href="{{ path('app_course_show', {'id': course.id}) }}">
                        {% if course.image %}
<img src="/uploads/courses/{{ course.image }}" alt="Image du cours" style="width: 200px;">    {% else %}
        <p>Aucune image</p>
    {% endif %}
                    </a>
                    <div class="wishlist save-icon" data-bs-toggle="modal" data-bs-target="#exampleModal-login">
<div>
    <div>
        
<button class="like-btn" data-id="{{ course.id }}">
    ❤️ <span class="like-count">{{ course.nbrLike }}</span>
</button>    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelector('.like-btn').addEventListener('click', function () {
        let courseId = this.getAttribute('data-id');

        fetch(`/course/${courseId}/like`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest' // Spécifie que c'est une requête AJAX
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.nbrLike !== undefined) {
                this.querySelector('.like-count').textContent = data.nbrLike;
            }
        });
    });
});
</script>

