<style>
    .form-inner {
    display: flex;
    flex-wrap: wrap; /* Permet aux champs de passer à la ligne suivante */
    gap: 15px;
    max-width: 100%;
    margin: 30px auto;
    padding: 20px;
    background: #ffffff;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    font-family: Arial, sans-serif;
}

.form-group {
    display: flex;
    flex-direction: column;
    width: calc(50% - 15px); /* Chaque champ prend 50% de la largeur de la ligne */
}

.form-group label {
    font-weight: bold;
    color: #333;
    margin-bottom: 5px;
    text-align: center;
    font-size: 18px; /* Taille de la police du label augmentée */
}

.form-group input, 
.form-group select, 
.form-group textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 5px;
    font-size: 16px;
    transition: 0.3s ease-in-out;
}

.form-group input:focus, 
.form-group select:focus, 
.form-group textarea:focus {
    border-color: #007bff;
    outline: none;
    box-shadow: 0 0 5px rgba(0, 123, 255, 0.2);
}

.form-inner button {
    padding: 12px;
    background: #007bff;
    color: white;
    border: none;
    border-radius: 5px;
    font-size: 16px;
    cursor: pointer;
    transition: 0.3s;
    width: 100%;
    margin-top: 20px;
}

.form-inner button:hover {
    background: #0056b3;
}

/* Pour les écrans plus petits, ajuster la disposition */
@media (max-width: 900px) {
    .form-group {
        width: calc(50% - 15px); /* Toujours 2 champs par ligne */
    }
}

@media (max-width: 600px) {
    .form-group {
        width: 100%; /* Un champ par ligne */
    }
}
/* Classe spécifique pour les boutons radio */
.radio-btn input[type="radio"] {
    display: none; /* Cache le bouton radio natif */
}

/* Créer l'apparence personnalisée du bouton radio */
.radio-btn label {
    display: inline-block;
    position: relative;
    padding-left: 35px; /* Espace pour l'icône du bouton radio */
    font-size: 18px;
    cursor: pointer;
    color: #333;
    line-height: 20px;
    user-select: none; /* Empêche la sélection du texte */
}

/* Créer un cercle pour le bouton radio */
.radio-btn label::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 20px;
    height: 20px;
    border: 2px solid #007bff; /* Bordure bleu clair */
    border-radius: 50%; /* Forme circulaire */
    background-color: #fff;
    transition: 0.3s ease; /* Transition douce pour les changements */
}

/* Lorsqu'un bouton radio est sélectionné */
.radio-btn input[type="radio"]:checked + label::before {
    background-color: #007bff; /* Fond bleu lorsqu'il est sélectionné */
    border-color: #0056b3; /* Bordure plus foncée */
    box-shadow: 0 0 5px rgba(0, 123, 255, 0.3); /* Légère ombre bleue */
}

/* Ajouter une coche lorsque sélectionné */
.radio-btn input[type="radio"]:checked + label::after {
    content: '✔'; /* Ajouter la coche */
    position: absolute;
    left: 4px;
    top: -2px;
    font-size: 14px;
    color: white; /* Couleur de la coche */
}

/* Changer la couleur du texte lorsque l'on survole l'élément */
.radio-btn label:hover {
    color: #007bff; /* Changer la couleur du texte du label au survol */
}



</style>



